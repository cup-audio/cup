{
  "rules": {
    "0": {
      "type": "anything",
      "redaction": { "method": "remove" }
    },
    "1": {
      "type": "pattern",
      "pattern": "^(?:[0-9a-f]{32}|[0-9A-F]{8}-[0-9A-F]{4}-[0-9A-F]{4}-[0-9A-F]{4}-[0-9A-F]{12})$",
      "redaction": { "method": "remove" }
    },
    "2": {
      "type": "pattern",
      "pattern": "(?i)[?&](?:token|key|sig|signature|auth|code|access_token)=([^&#\\s]+)",
      "replaceGroups": [1],
      "redaction": { "method": "replace", "text": "[Filtered]" }
    }
  },
  "applications": {
    "$user.geo.city || $user.geo.subdivision || $user.geo.region": ["0"],
    "contexts.device.id || contexts.app.device_app_hash": ["0"],
    "$user.id": ["1"],
    "$breadcrumb.data.url || $breadcrumb.data.from || $breadcrumb.data.to": ["2"],
    "$string": ["@email:replace"]
  }
}
