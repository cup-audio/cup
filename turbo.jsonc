{
  "$schema": "./node_modules/turbo/schema.json",
  "noUpdateNotifier": true,
  "concurrency": "100%",
  "agentGuidance": false,
  "globalDependencies": ["apps/cloudflare-worker/wrangler.jsonc"],
  "futureFlags": {
    "watchUsingTaskInputs": true,
  },
  "tasks": {
    "turbo:cf-typegen": {
      "cache": true,
      "outputs": ["worker-configuration.d.ts"],
    },
    "turbo:build": {
      "cache": false,
      "inputs": ["$TURBO_DEFAULT$", "!*.md", "!LICENSE"],
    },
    "turbo:lint": {
      "cache": false,
      "inputs": ["$TURBO_DEFAULT$", "!*.md", "!LICENSE"],
    },
    "turbo:lint:fix": {
      "cache": false,
      "inputs": ["$TURBO_DEFAULT$", "!*.md", "!LICENSE"],
    },
    "turbo:test": {
      "cache": false,
      "inputs": ["$TURBO_DEFAULT$", "!*.md", "!LICENSE"],
    },
  },
}
