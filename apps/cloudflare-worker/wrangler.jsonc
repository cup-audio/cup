{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "create-audiobook-from-url",
  "main": "src/index.ts",
  "compatibility_flags": ["nodejs_compat"],
  "compatibility_date": "2026-08-18",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "cup.audio",
      "custom_domain": true,
    },
    // The remaining hostnames only redirect to cup.audio; see libs/api-server/src/http/domain-routing.ts.
    {
      "pattern": "www.cup.audio",
      "custom_domain": true,
    },
    {
      "pattern": "www.cup-audio.com",
      "custom_domain": true,
    },
    {
      "pattern": "cup-audio.com",
      "custom_domain": true,
    },
    {
      "pattern": "create-audiobook-from-url.patricktree.me",
      "custom_domain": true,
    },
  ],
  "assets": {
    "binding": "ASSETS",
    "not_found_handling": "none",
    "html_handling": "none",
    "run_worker_first": true,
  },
  // Sentry receives the Worker's errors, traces and logs (docs/architecture/observability.md), so
  // Cloudflare's own observability records nothing: no invocation logs, Workers Logs, traces or Issues.
  "observability": {
    "enabled": false,
    "logs": {
      "enabled": false,
      "invocation_logs": false,
    },
    "traces": {
      "enabled": false,
    },
    "issues": {
      "enabled": false,
    },
  },
  "limits": {
    "cpu_ms": 300000,
  },
  // Source maps go to Sentry, not to Cloudflare.
  "upload_source_maps": false,
  // `CF_VERSION_METADATA.id` is the release of every Sentry event.
  "version_metadata": {
    "binding": "CF_VERSION_METADATA",
  },
  "browser": {
    "binding": "BROWSER",
  },
  "workflows": [
    {
      "name": "prepare-audiobook",
      "binding": "PREPARE_AUDIOBOOK_WORKFLOW",
      "class_name": "PrepareAudiobookWorkflow",
    },
    {
      "name": "synthesize-audio-segment",
      "binding": "SYNTHESIZE_AUDIO_SEGMENT_WORKFLOW",
      "class_name": "SynthesizeAudioSegmentWorkflow",
    },
  ],
  "durable_objects": {
    "bindings": [
      { "name": "ACCOUNTS", "class_name": "AccountDurableObject" },
      {
        "name": "CONVERSION_GRANTS",
        "class_name": "ConversionGrantDurableObject",
      },
      {
        "name": "REGISTRY",
        "class_name": "RegistryDurableObject",
      },
    ],
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "ConversionGrantDurableObject",
        "ConversionGrantRegistryDurableObject",
      ],
    },
    {
      "tag": "v2",
      "new_sqlite_classes": ["AccountDurableObject"],
    },
    {
      "tag": "v3",
      "renamed_classes": [
        { "from": "ConversionGrantRegistryDurableObject", "to": "RegistryDurableObject" },
      ],
    },
  ],
  "ai": {
    "binding": "AI",
  },
  "vars": {
    "LOCAL_DEVELOPMENT": "false",
    // Local development only: `pnpm dev:services` overrides these in `.env.local`, and the Worker
    // ignores them unless LOCAL_DEVELOPMENT is "true" (docs/adr/0012). Local dev loads only
    // declared keys, so they need these empty defaults.
    "LOCAL_TEST_ACCOUNT_EMAIL": "",
    "LOCAL_TEST_ACCOUNT_PASSWORD": "",
    // The `cup-worker` DSN (CUP_WORKER_DSN in @cup/telemetry.core), public by design. It must agree
    // with LOCAL_DEVELOPMENT: `pnpm dev:services` sets it to "" next to LOCAL_DEVELOPMENT=true.
    "SENTRY_DSN": "https://aa6ceda71485efec30877677d4eb919b@o4512441473040384.ingest.de.sentry.io/4512441485623377",
    "SIGNUP_IP_LIMIT": "10",
    "CONVERSION_IP_LIMIT": "60",
    "CONVERSION_OWNER_LIMIT": "10",
    "SUPABASE_URL": "https://evwjipxgacwotgbmqtla.supabase.co",
    "RESEND_BASE_URL": "https://api.resend.com",
    "CLOUDFLARE_ACCOUNT_ID": "a7648178b6a63bb8a13f0c9de89d253f",
    "OPERATOR_ACCESS_ISSUER": "https://patricktree.cloudflareaccess.com",
    "OPERATOR_ACCESS_AUDIENCE": "eb0bf97161ed0be7fdbaa018493cc84d3b25332315cfa8fec3569570035e3461",
    "OPERATOR_EMAIL": "patrick.kerschbaum@gmail.com",
  },
  "r2_buckets": [
    {
      "binding": "AUDIO_BUCKET",
      "bucket_name": "create-audiobook-from-url-audio",
    },
  ],
  "secrets": {
    "required": [
      "CLOUDFLARE_API_KEY",
      "SOURCE_PAGE_COOKIES_JSON",
      "SUPABASE_SECRET_KEY",
      "SUPABASE_PUBLISHABLE_KEY",
      "GOOGLE_WEB_CLIENT_ID",
      "RESEND_API_KEY",
      "MEDIA_URL_SIGNING_KEY",
    ],
  },
}
