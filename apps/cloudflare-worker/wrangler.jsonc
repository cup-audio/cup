{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "create-audiobook-from-url",
  "main": "src/index.ts",
  "compatibility_flags": ["nodejs_compat"],
  "compatibility_date": "2026-08-18",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "cup.audio",
      "custom_domain": true,
    },
    {
      "pattern": "www.cup.audio",
      "custom_domain": true,
    },
    {
      "pattern": "www.cup-audio.com",
      "custom_domain": true,
    },
    {
      "pattern": "cup-audio.com",
      "custom_domain": true,
    },
    {
      "pattern": "create-audiobook-from-url.patricktree.me",
      "custom_domain": true,
    },
  ],
  "assets": {
    "binding": "ASSETS",
    "not_found_handling": "none",
    "html_handling": "none",
    "run_worker_first": true,
  },
  "observability": {
    "enabled": false,
    "logs": {
      "enabled": false,
      "invocation_logs": false,
    },
    "traces": {
      "enabled": false,
    },
    "issues": {
      "enabled": false,
    },
  },
  "limits": {
    "cpu_ms": 300000,
  },
  "upload_source_maps": false,
  "version_metadata": {
    "binding": "CF_VERSION_METADATA",
  },
  "browser": {
    "binding": "BROWSER",
  },
  "workflows": [
    {
      "name": "prepare-audiobook",
      "binding": "PREPARE_AUDIOBOOK_WORKFLOW",
      "class_name": "PrepareAudiobookWorkflow",
    },
    {
      "name": "synthesize-audio-segment",
      "binding": "SYNTHESIZE_AUDIO_SEGMENT_WORKFLOW",
      "class_name": "SynthesizeAudioSegmentWorkflow",
    },
  ],
  "durable_objects": {
    "bindings": [
      { "name": "ACCOUNTS", "class_name": "AccountDurableObject" },
      {
        "name": "CONVERSION_GRANTS",
        "class_name": "ConversionGrantDurableObject",
      },
      {
        "name": "REGISTRY",
        "class_name": "RegistryDurableObject",
      },
    ],
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "ConversionGrantDurableObject",
        "ConversionGrantRegistryDurableObject",
      ],
    },
    {
      "tag": "v2",
      "new_sqlite_classes": ["AccountDurableObject"],
    },
    {
      "tag": "v3",
      "renamed_classes": [
        { "from": "ConversionGrantRegistryDurableObject", "to": "RegistryDurableObject" },
      ],
    },
  ],
  "ai": {
    "binding": "AI",
  },
  "vars": {
    "LOCAL_DEVELOPMENT": "false",
    "LOCAL_TEST_ACCOUNT_EMAIL": "",
    "LOCAL_TEST_ACCOUNT_PASSWORD": "",
    "SENTRY_DSN": "https://aa6ceda71485efec30877677d4eb919b@o4512441473040384.ingest.de.sentry.io/4512441485623377",
    "SENTRY_TUNNEL_DSNS": "https://4675dd0e4efd764f8941a9a0482a044d@o4512441473040384.ingest.de.sentry.io/4512441485623376",
    "SIGNUP_IP_LIMIT": "10",
    "CONVERSION_IP_LIMIT": "60",
    "CONVERSION_OWNER_LIMIT": "10",
    "SUPABASE_URL": "https://evwjipxgacwotgbmqtla.supabase.co",
    "APPLE_WEB_CLIENT_ID": "audio.cup.app.web",
    "APPLE_NATIVE_CLIENT_ID": "audio.cup.app",
    "APPLE_KEY_ID": "6Y358M9M9A",
    "APPLE_TEAM_ID": "4GQ2V3WJW8",
    "APPLE_ORIGIN": "https://appleid.apple.com",
    "RESEND_BASE_URL": "https://api.resend.com",
    "CLOUDFLARE_ACCOUNT_ID": "a7648178b6a63bb8a13f0c9de89d253f",
    "OPERATOR_ACCESS_ISSUER": "https://patricktree.cloudflareaccess.com",
    "OPERATOR_ACCESS_AUDIENCE": "eb0bf97161ed0be7fdbaa018493cc84d3b25332315cfa8fec3569570035e3461",
    "OPERATOR_EMAIL": "patrick.kerschbaum@gmail.com",
  },
  "r2_buckets": [
    {
      "binding": "AUDIO_BUCKET",
      "bucket_name": "create-audiobook-from-url-audio",
    },
  ],
  "secrets": {
    "required": [
      "CLOUDFLARE_API_KEY",
      "SOURCE_PAGE_COOKIES_JSON",
      "SUPABASE_SECRET_KEY",
      "SUPABASE_PUBLISHABLE_KEY",
      "GOOGLE_WEB_CLIENT_ID",
      "RESEND_API_KEY",
      "MEDIA_URL_SIGNING_KEY",
      "APPLE_SIGN_IN_KEY",
    ],
  },
}
