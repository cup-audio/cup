{
  "name": "@cup/mobile-app",
  "private": true,
  "imports": {
    "#scripts/*": "./scripts/*"
  },
  "exports": {
    "./android-sdk": {
      "types": "./dist/types/android-sdk.d.mts",
      "default": "./scripts/android-sdk.mts"
    }
  },
  "scripts": {
    "android:run": "node scripts/android-run.mts",
    "android:upload-key:create": "node scripts/android-upload-key-create.mts",
    "build": "turbo run turbo:build && pnpm run native:sync",
    "jvm:check": "node scripts/jvm-toolchain.mts",
    "lint": "turbo run turbo:lint",
    "lint:fix": "turbo run turbo:lint:fix",
    "native:sync": "cap sync android && cap sync ios",
    "symbols:upload": "upload-shell-symbols --web-source-map-dir ../web-app/dist/source-maps --android-web-dir android/app/src/main/assets/public",
    "test": "node scripts/test-jvm.mts",
    "turbo:build": "tsc --build",
    "turbo:lint": "oxlint --type-aware --max-warnings 0 .",
    "turbo:lint:fix": "pnpm run turbo:lint --fix",
    "turbo:test": "pnpm run test"
  },
  "dependencies": {
    "@aparajita/capacitor-secure-storage": "8.0.1",
    "@capacitor/android": "^8.5.3",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.5.3",
    "@capacitor/ios": "^8.5.3",
    "@capawesome/capacitor-google-sign-in": "0.1.4",
    "@cup/web-app": "workspace:*",
    "@sentry/capacitor": "catalog:sentry-client"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.3",
    "@cup/config-oxlint": "workspace:*",
    "@cup/source-maps": "workspace:*",
    "@patricktree-stack/config-typescript": "workspace:*",
    "@types/node": "catalog:",
    "@typescript/native": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "typescript": "catalog:"
  }
}
